# Options for a UML guest that tests the VDUSE virtio-blk backend under the
# launcher's sandbox, serving a ramdisk. Merge on top of x86_64_defconfig and
# driver-guest.config with scripts/kconfig/merge_config.sh.

# The guest exports a disk to the host through VDUSE.
CONFIG_UML_VDUSE=y
CONFIG_VDUSE_GUEST_BLK=y

# The ramdisk, sized with brd.rd_nr= and brd.rd_size=.
CONFIG_BLK_DEV_RAM=y

# Four CPUs, so that each of four queues can have one of its own.
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# The tests fail on a kernel warning, so with lock debugging they also check
# the locking.
CONFIG_PROVE_LOCKING=y
