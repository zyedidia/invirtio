# Options for a UML driver guest for the Intel X710 or I226-V, which it
# exports to the host as a virtio-net device. Merge on top of
# x86_64_defconfig and driver-guest.config with
# scripts/kconfig/merge_config.sh.

# The NIC is passed through with VFIO.
CONFIG_UML_PCI_OVER_VFIO=y

# The guest exports the NIC to the host through VDUSE.
CONFIG_UML_VDUSE=y

CONFIG_NET=y
CONFIG_INET=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_I40E=y
CONFIG_IGC=y

# The backend that exports the NIC as a virtio-net device.
CONFIG_VDUSE_GUEST_NET=y

# Without IPv6, the guest sends no neighbor discovery of its own on the
# exported interface. TCP GRO for IPv6 is built with INET.
# CONFIG_IPV6 is not set
