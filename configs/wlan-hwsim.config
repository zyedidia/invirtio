# Options for a virtio-wlan test guest that has mac80211_hwsim radios in
# place of the MT7922, so that the whole path can be tested on any machine.
# Merge on top of x86_64_defconfig, driver-guest.config and wlan-guest.config
# with scripts/kconfig/merge_config.sh. The guest's command line sets the
# number of radios with mac80211_hwsim.radios=4, and scripts/wlan-hwsim-init
# starts the access points.

CONFIG_MAC80211_HWSIM=y

# A test of the client API that runs against the access points. It is
# started through debugfs.
CONFIG_DEBUG_FS=y
CONFIG_CFG80211_CLIENT_TEST=y

# The access points share a bridge, which holds the address of their DHCP and
# iperf3 servers.
CONFIG_BRIDGE=y
