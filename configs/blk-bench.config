# Options for a UML guest that benchmarks the VDUSE virtio-blk backend,
# serving its own null_blk, with or without the launcher's sandbox. Merge on
# top of x86_64_defconfig and driver-guest.config with
# scripts/kconfig/merge_config.sh. driver-guest.config leaves lock
# debugging off.

# The guest exports its null_blk to the host through VDUSE.
CONFIG_UML_VDUSE=y
CONFIG_VDUSE_GUEST_BLK=y
CONFIG_BLK_DEV_NULL_BLK=y

# Up to four CPUs, each with a queue of its own.
CONFIG_SMP=y
CONFIG_NR_CPUS=4
