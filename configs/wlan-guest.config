# Options for a UML driver guest for the MediaTek MT7922, which it exports to
# the host as a virtio-wlan device. Merge on top of x86_64_defconfig and
# driver-guest.config with scripts/kconfig/merge_config.sh.

# The card is passed through with VFIO.
CONFIG_UML_PCI_OVER_VFIO=y

# The guest exports the card to the host through VDUSE.
CONFIG_UML_VDUSE=y

CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# The in-kernel client API of cfg80211, which drives the card from kernel code.
CONFIG_CFG80211_CLIENT=y

# The backend that exports the card as a virtio-wlan device.
CONFIG_VDUSE_GUEST_WLAN=y

# Nothing in the guest uses wireless extensions.
# CONFIG_CFG80211_WEXT is not set

# The host decides whether power save is on.
# CONFIG_CFG80211_DEFAULT_PS is not set

# Without IPv6, the guest sends no neighbor discovery of its own on the
# exported interface.
# CONFIG_IPV6 is not set
