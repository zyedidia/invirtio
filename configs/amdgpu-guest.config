# Options for a UML driver guest for an AMD GPU. Merge on top of
# x86_64_defconfig and driver-guest.config with
# scripts/kconfig/merge_config.sh.

# The GPU is passed through with VFIO.
CONFIG_UML_PCI_OVER_VFIO=y

CONFIG_SMP=y
CONFIG_NR_CPUS=4

# amdgpu and its display code, which uses the kernel FPU.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y

# An fbdev client tests display output without userspace.
CONFIG_DRM_FBDEV_EMULATION=y

# amdgpu's debugfs files report its firmware and run its ring tests.
CONFIG_DEBUG_FS=y

# The guest runs no compute workloads and does not map guest process memory
# for the GPU.
# CONFIG_HSA_AMD is not set
# CONFIG_DRM_AMDGPU_USERPTR is not set
