# Options for an x86-64 driver guest that runs from an initramfs under Cloud
# Hypervisor. Merge on top of x86_64_defconfig with
# scripts/kconfig/merge_config.sh.

# The initramfs holds the guest's userspace.
CONFIG_BLK_DEV_INITRD=y

# The guest's console is Cloud Hypervisor's serial port.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# The guest uses KVM's clock and paravirtual features.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# Passed-through devices interrupt with MSI-X.
CONFIG_PCI_MSI=y

# Disks for the VDUSE blk backend to serve.
CONFIG_BLK_DEV_NULL_BLK=y
CONFIG_BLK_DEV_RAM=y

# UML's timer frequency, so that the two guests compare fairly. UML's guests
# use voluntary preemption, which x86 does not offer. Lazy preemption is the
# closest, since it defers preempting a normal task to the next tick or the
# return to user space.
CONFIG_HZ_100=y
CONFIG_PREEMPT_LAZY=y

# Lock debugging adds work to every lock operation and interrupt state
# change, and several times the guest's CPU time per I/O.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
