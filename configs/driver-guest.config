# Options for a UML driver guest that runs from an initramfs without host
# files. Merge with scripts/kconfig/merge_config.sh.

# The initramfs holds the guest's userspace and firmware.
CONFIG_BLK_DEV_INITRD=y

# A static UML does not open the dynamic loader's paths when it starts.
CONFIG_STATIC_LINK=y

# These open host paths at boot. The kernel's RNG is seeded from the host
# with getrandom() instead.
# CONFIG_UML_RANDOM is not set
# CONFIG_BLK_DEV_UBD is not set
# CONFIG_PTY_CHAN is not set
