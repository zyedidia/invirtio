# Options for a UML guest that tests the VDUSE virtio-net backend, by
# exporting one end of a veth pair or a port of a NIC that it drives. Merge
# on top of x86_64_defconfig, driver-guest.config and net-guest.config with
# scripts/kconfig/merge_config.sh.

# The pair that scripts/net-test-init makes when the guest runs without a
# NIC. The backend looks for its interface before init runs, so the script
# makes the pair as the uevent helper, which the kernel runs from the
# initramfs during boot.
CONFIG_VETH=y
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH="/init"
