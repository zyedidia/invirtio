# VDUSE from the running kernel's version, which replaces the kernel's own.
obj-m += vduse.o
vduse-y := vduse_dev.o iova_domain.o

# The virtio-wlan driver, whose source and headers are in linux-host/linux,
# built through virtio_wlan_compat.c.
obj-m += virtio_wlan.o
virtio_wlan-y := virtio_wlan_compat.o
CFLAGS_virtio_wlan_compat.o := -I$(src)/include
